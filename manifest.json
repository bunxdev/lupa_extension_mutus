{
  "manifest_version": 3,
  "name": "Mutus",
  "version": "0.2.0",
  "description": "Mutea, salta y registra anuncios de YouTube automáticamente. Restaura el volumen cuando termina el comercial.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "mutus — auto-mute de anuncios",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
